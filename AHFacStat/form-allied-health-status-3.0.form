addon    SCCoPIFO
html     form-allied-health-status-v3.html
version  3.0
title    Allied Health Status Report
indef    an allied health status report
create   AHFacStat a
pdfFile  Allied_Health_Status_Report_v20260506.pdf

field MsgNo originMessageID
  label    "1. Origin Message Number"
  type     messageID
  presence required
  help     "This is the message number assigned to the message by the origin station.  Valid message numbers have the form XXX-###P, where XXX is the three-character message number prefix assigned to the station, ### is a sequence number (any number of digits), and P is an optional suffix letter.  This field is required."
  pdf      text L 228.64 R 339.76 B 702.80 T 717.52 BL 706.32
  pdf      text P 2 L 486.36 R 576.24 B 723.48 T 749.16 BL 732.00

field DestMsgNo destinationMessageID
  label    "2. Destination Message Number"
  type     messageID
  pdf      text L 447.16 R 573.76 B 702.80 T 717.52 BL 706.32

field 1a. messageDate
  label    "2. Message Date"
  type     date
  presence required
  help     "This is the date the message was written, in MM/DD/YYYY format.  It is required."
  pdf      text L  81.04 R 141.76 B 651.68 T 670.72 BL 657.36

field 1b. messageTime
  label    "3. Message Time"
  type     time
  presence required
  help     "This is the time the message was written, in HH:MM format (24-hour clock).  It is required."
  pdf      text L 190.00 R 236.32 B 651.68 T 670.72 BL 657.36

field -
  label    "2-3. Message Date/Time"
  type     dateTime
  children 1a. 1b.
  presence required
  help     "This is the date and time the message was written, in MM/DD/YYYY HH:MM format (24-hour clock).  It is required."

field 5. handling
  label    "5. Handling"
  type     restricted
  value    ROUTINE
  choice   IMMEDIATE
  choice   PRIORITY
  choice   ROUTINE
  presence required
  help     "This is the message handling order, which specifies how fast it needs to be delivered.  Allowed values are \"ROUTINE\" (within 2 hours), \"PRIORITY\" (within 1 hour), and \"IMMEDIATE\".  This field is required."
  pdf      if 5.=IMMEDIATE then circle X 309.84 Y 661.32 R 2.72
  pdf      if 5.=PRIORITY then  circle X 406.80 Y 661.32 R 2.66
  pdf      if 5.=ROUTINE then   circle X 487.92 Y 661.32 R 2.66

field 7a. toICSPosition
  label    "6. To ICS Position"
  choice   Health Care Liaison
  choice   EMS Unit
  choice   Public Health Unit
  choice   Medical Health Branch
  choice   Operations Section
  presence required
  help     "This is the ICS position to which the message is addressed.  It is required."
  pdf      text L 138.16 R 285.76 B 629.60 T 647.20 BL 634.56

field 7b. toLocation
  label    "7. To Location"
  choice   PHDOC
  choice   County EOC
  presence required
  help     "This is the location of the recipient ICS position.  It is required."
  pdf      text L 138.16 R 285.76 B 607.04 T 625.12 BL 612.24

field 7c. toName
  label    "8. To Name"
  help     "This is the name of the person holding the recipient ICS position.  It is optional and rarely provided."
  pdf      text L 138.16 R 285.76 B 584.48 T 602.56 BL 589.68

field 7d. toContact
  label    "9. To Contact Info"
  help     "This is contact information (phone number, email, etc.) for the receipient.  It is optional and rarely provided."
  pdf      text L 138.16 R 285.76 B 561.92 T 580.00 BL 567.12

field 8a. fromICSPosition
  label    "10. From ICS Position"
  presence required
  help     "This is the ICS position of the message author.  It is required."
  pdf      text L 394.72 R 572.56 B 629.60 T 647.20 BL 634.56

field 8b. fromLocation
  label    "11. From Location"
  presence required
  help     "This is the location of the message author.  It is required."
  pdf      text L 394.72 R 572.56 B 607.04 T 625.12 BL 612.24

field 8c. fromName
  label    "12. From Name"
  help     "This is the name of the message author.  It is optional and rarely provided."
  pdf      text L 394.72 R 572.56 B 584.48 T 602.56 BL 589.68

field 8d. fromContact
  label    "13. From Contact Info"
  help     "This is contact information (phone number, email, etc.) for the message author.  It is optional and rarely provided."
  pdf      text L 394.72 R 572.56 B 561.92 T 580.00 BL 567.12

field 21. messageSummary
  label    "21. Facility Name"
  presence required
  help     "This is the name of the facility whose status is being reported.  It is required."
  pdf      text L 126.04 R 294.64 B 524.24 T 541.84 BL 529.20

field 22.
  label    "22. Facility Type"
  help     "This is the type of the facility, such as Skilled Nursing, Home Health, Dialysis, Community Health Center, Surgical Center, or Hospice."
  pdf      text L 382.12 R 572.56 B 524.24 T 541.84 BL 529.20

field 23.
  label    "23. EOC Status"
  type     restricted
  mchoice  Activated a. Activated
  mchoice  Monitoring b. Monitoring
  mchoice  "Not Activated" c. Not Activated
  help     "This indicates the status of the facility's emergency operations center."
  pdf      if 23.=Activated then circle X 208.38 Y 511.14 R 2.78
  pdf      if 23.=Monitoring then circle X 320.88 Y 511.08 R 2.72
  pdf      if 23.="Not Activated" then circle X 428.88 Y 511.08 R 2.72

field 24.
  label    "24. Operational Status"
  type     restricted
  mchoice  "Fully Operational" a. Fully Operational
  mchoice  "Limited Services" b. Limited Services
  mchoice  Closed c. Closed
  mchoice  Evacuating d. Evacuating
  mchoice  "Shelter in Place" e. Shelter in Place
  help     "This indicates the operational status of the facility."
  pdf      if 24.="Fully Operational" then circle X 208.38 Y 492.18 R 2.78
  pdf      if 24.="Limited Services" then circle X 320.82 Y 492.18 R 2.66
  pdf      if 24.=Closed then circle X 208.38 Y 476.52 R 2.90
  pdf      if 24.=Evacuating then circle X 320.88 Y 476.58 R 2.36
  pdf      if 24.="Shelter in Place" then circle X 428.88 Y 476.52 R 2.72

field 25. defaultBody
  label    "25. Not Operational Details"
  type     multiline
  help     "If the facility is not fully operational, include the details in this field."
  pdf      text L  41.44 R 572.56 B 429.68 T 453.52 A lT

field 31.
  label    "31. Facility EOC"
  help     "This provides the contact information (phone number, fax number, email address) for the facility EOC."
