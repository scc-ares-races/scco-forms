addon    SCCoPIFO
html     form-ics213.html
version  2.3
title    ICS-213 General Message Form
indef    an ICS-213 general message form
create   ICS213 i
pdfFile  XSC_ICS-213_v20260512.pdf
deftext  FT Times-Roman FS 12.0 MS 8.0 LH 1.15 A lF C 000099

field MsgNo originMessageID
  label    "1. Origin Message Number"
  type     messageID
  presence required
  help     "This is the message number assigned to the message by the origin station.  Valid message numbers have the form XXX-###P, where XXX is the three-character message number prefix assigned to the station, ### is a sequence number (any number of digits), and P is an optional suffix letter.  This field is required."
  pdf      text L 228.40 R 348.88 B 716.24 T 730.96 BL 719.76

field DestMsgNo destinationMessageID
  label    "2. Destination Message Number"
  type     messageID
  pdf      text L 456.28 R 573.76 B 716.24 T 730.96 BL 719.76

field 1a. messageDate
  label    "3. Date"
  type     date
  presence required
  help     "This is the date the message was written, in MM/DD/YYYY format.  It is required."
  pdf      text L  81.28 R 137.20 B 673.04 T 690.40 BL 678.00

field 1b. messageTime
  label    "4. Time"
  type     time
  presence required
  help     "This is the time the message was written, in HH:MM format (24-hour clock).  It is required."
  pdf      text L 184.96 R 231.76 B 673.04 T 690.40 BL 678.00

field -
  label    "3-4. Date/Time"
  type     dateTime
  children 1a. 1b.
  presence required
  help     "This is the date and time the message was written, in MM/DD/YYYY HH:MM format (24-hour clock).  It is required."

field 5. handling
  label    "5. Handling"
  type     restricted
  choice   IMMEDIATE
  choice   PRIORITY
  choice   ROUTINE
  presence required
  help     "This is the message handling order, which specifies how fast it needs to be delivered.  Allowed values are \"ROUTINE\" (within 2 hours), \"PRIORITY\" (within 1 hour), and \"IMMEDIATE\".  This field is required."
  pdf      if 5.=IMMEDIATE then circle X 305.16 Y 681.96 R 2.84
  pdf      if 5.=PRIORITY then circle X 408.60 Y 681.96 R 2.72
  pdf      if 5.=ROUTINE then circle X 496.02 Y 682.02 R 2.78

field 7. toICSPosition
  label    "6. To ICS Position"
  presence required
  help     "This is the ICS position to which the message is addressed.  It is required."
  pdf      text L 137.92 R 299.92 B 650.96 T 668.56 BL 655.92

field 9a. toLocation
  label    "7. To Location"
  presence required
  help     "This is the location of the recipient ICS position.  It is required."
  pdf      text L 137.92 R 299.92 B 628.40 T 646.48 BL 633.60

field ToName toName
  label    "8. To Name"
  help     "This is the name of the person holding the recipient ICS position.  It is optional and rarely provided."
  pdf      text L 137.92 R 299.92 B 605.84 T 623.92 BL 611.04

field ToTel toContact
  label    "9. To Contact Info"
  help     "This is contact information (phone number, email, etc.) for the receipient.  It is optional and rarely provided."
  compare  exact
  pdf      text L 137.92 R 299.92 B 583.28 T 601.36 BL 588.48

field 8. fromICSPosition
  label    "10. From ICS Position"
  presence required
  help     "This is the ICS position of the message author.  It is required."
  pdf      text L 409.12 R 572.56 B 650.96 T 668.56 BL 655.92

field 9b. fromLocation
  label    "11. From Location"
  presence required
  help     "This is the location of the message author.  It is required."
  pdf      text L 409.12 R 572.56 B 628.40 T 646.48 BL 633.60

field FmName fromName
  label    "12. From Name"
  help     "This is the name of the message author.  It is optional and rarely provided."
  pdf      text L 409.12 R 572.56 B 605.84 T 623.92 BL 611.04

field FmTel fromContact
  label    "13. From Contact Info"
  help     "This is contact information (phone number, email, etc.) for the message author.  It is optional and rarely provided."
  compare  exact
  pdf      text L 409.12 R 572.56 B 583.28 T 601.36 BL 588.48

field 6a.
  label    "14. Take Action"
  type     restricted
  choice   Yes
  choice   No
  help     "This indicates whether the sender expects the recipient to take action based on this message."
  pdf      if 6a.=Yes then circle X 285.96 Y 570.12 R 2.84
  pdf      if 6a.=No then circle X 324.84 Y 570.12 R 2.84

field 6b.
  label    "15. Reply"
  type     restricted
  choice   Yes
  choice   No
  help     "This indicates whether the sender expects the recipient to reply to this message."
  pdf      if 6b.=Yes then circle X 286.02 Y 547.38 R 2.90
  pdf      if 6b.=No then circle X 324.84 Y 547.38 R 2.84

field 6d.
  label    "16. Reply By"
  presence if 6b.=Yes then optional else blocked
  help     "This is the time by which the sender expects a reply from the recipient.  It can be set only if \"Reply\" is \"Yes\"."
  compare  exact
  pdf      text L 449.32 R 572.56 B 537.68 T 556.00 BL 542.16

field 10. messageSummary
  label    "21. Subject"
  presence required
  help     "This is the subject of the message.  It is required."
  pdf      text L 117.28 R 572.56 B 497.36 T 515.68 BL 502.32

field 11. reference
  label    "22. Reference"
  help     "This is the origin message number of the previous message to which this message is responding."
  compare  exact
  pdf      text L 117.28 R 450.40 B 474.56 T 492.88 BL 479.52

field 12. defaultBody
  label    "23. Message"
  type     multiline
  presence required
  help     "This is the text of the message.  It is required."
  pdf      text L  42.40 R 572.56 B 129.44 T 452.56 A lT

field OpRelayRcvd
  label    "Operator: Relay Received"
  help     "This is the name of the station from which this message was directly received.  It is filled in for messages that go through a relay station."
  pdf      text L 110.08 R 321.76 B  86.48 T 100.96 BL 90.00

field OpRelaySent
  label    "Operator: Relay Sent"
  help     "This is the name of the station to which this message was directly sent.  It is filled in for messages that go through a relay station."
  pdf      text L 356.08 R 573.76 B  86.48 T 100.96 BL 90.00

field OpName operatorName
  label    "Operator: Name"
  presence required
  pdf      text L  74.80 R 249.76 B  67.52 T  82.00 BL 71.04

field OpCall operatorCall
  label    "Operator: Call Sign"
  presence required
  pdf      text L 301.72 R 366.88 B  67.52 T  82.00 BL 71.04

field -
  label    Operator
  type     join
  children OpName OpCall

field OpDate operatorDate
  label    "Operator: Date"
  type     date
  pdf      text L 402.40 R 474.88 B  67.52 T  82.00 BL 71.04

field OpTime operatorTime
  label    "Operator: Time"
  type     time
  pdf      text L 511.36 R 573.76 B  67.52 T  82.00 BL 71.04

field -
  label    "Operator: Date/Time"
  type     dateTime
  children OpDate OpTime

field -
  pdf      box L  34.32 R 116.52 B  36.48 T  47.76 F FFFFFF
  pdf      box L 524.88 R 576.36 B  36.24 T  48.48 F FFFFFF
